# Copy to .env and fill in. Never commit .env.
# Values marked (required) must be set; the app refuses to start without them.

# --- Database (required) -------------------------------------------------------
# Local: postgresql://market:market@localhost:5432/market
# Staging/production: your Neon or Supabase connection string (use the pooled URL).
DATABASE_URL=postgresql://market:market@localhost:5432/market

# --- Auth ------------------------------------------------------------------------
# "dev" = local sign-in for development and tests (no Clerk account needed).
# "clerk" = real sign-in; required on every deployed environment.
AUTH_PROVIDER=dev
# Lets a production build use dev sign-in. Only for the e2e tests; never set on a deployed site.
# ALLOW_DEV_AUTH=true

# Clerk (required when AUTH_PROVIDER=clerk). From dashboard.clerk.com > API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# From Clerk > Webhooks, for an endpoint at https://<your-domain>/api/webhooks/clerk
# subscribed to user.created, user.updated and user.deleted.
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Rate limiting (recommended when deployed) ------------------------------------
# Upstash Redis. Without these, an in-memory limiter is used (per server instance only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Error monitoring (optional locally) -------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# For uploading source maps from CI/Vercel builds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Site ----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp support number in international format without + or spaces.
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=254700000000
# Public origin of the R2 bucket (r2.dev URL or custom domain). Required with R2.
# NEXT_PUBLIC_IMAGE_ORIGIN=https://images.example.com

# --- Listing photos (Phase 2) -------------------------------------------------------
# Cloudflare R2. Leave all empty locally: photos are then stored in .data/storage.
# On a deployed site without these, photo uploads are switched off with a friendly message.
# Create a bucket, an API token with Object Read & Write on it, and turn on public access
# (r2.dev or a custom domain). Add a CORS rule allowing PUT from your site's origin, and a
# lifecycle rule deleting objects under "incoming/" after 1 day.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional locally: signs local-disk upload links.
UPLOAD_SIGNING_SECRET=

# --- Search (Phase 2) -----------------------------------------------------------------
# Meilisearch Cloud or self-hosted. Without it, search uses Postgres fuzzy matching.
# Run `pnpm search:reindex` once after setting these (and after restoring a database).
MEILISEARCH_HOST=
MEILISEARCH_ADMIN_KEY=
# Lets staging and production share one Meilisearch project, e.g. "staging_".
MEILISEARCH_INDEX_PREFIX=

# --- Payments and email (Phase 3) -----------------------------------------------------
# Paystack secret key (sk_test_… until launch). Without it, local development uses a mock
# gateway with a sandbox page, and a deployed site shows "checkout isn't switched on yet".
# In the Paystack dashboard set the webhook URL to https://<your-domain>/api/webhooks/paystack,
# enable M-Pesa (mobile money) and transfers, and turn off OTP for API transfers.
PAYSTACK_SECRET_KEY=
# Resend for order emails. Without it, emails are only stored (see /dev/outbox locally).
RESEND_API_KEY=
# Sender, on a domain verified in Resend.
EMAIL_FROM="Soko <orders@soko.example>"

# --- Scheduled jobs --------------------------------------------------------------------
# Vercel sends this to cron routes (daily search index repair, order expiry, auto-release
# and payout retries). Any long random string.
CRON_SECRET=
